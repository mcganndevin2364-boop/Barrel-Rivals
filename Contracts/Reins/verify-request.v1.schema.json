{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:barrelrivals:reins:verify-request:1",
  "title": "Reins Lab local replay verification request v1",
  "description": "Offline consistency only. The caller supplies an untrusted local manifest. This contract does not authorize competitive results or rewards.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "manifest", "frames"],
  "properties": {
    "contractVersion": { "const": 1 },
    "manifest": { "$ref": "#/$defs/manifest" },
    "frames": {
      "type": "array", "minItems": 1, "maxItems": 7500,
      "description": "Full input state for each consecutive 20 ms tick, starting at tick 1 after Start(). No gaps, repeated ticks or frames after a terminal state.",
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "permille": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "horse": {
      "type": "object", "additionalProperties": false,
      "required": ["nervePermille", "firePermille", "biddabilityPermille", "heartPermille"],
      "properties": {
        "nervePermille": { "$ref": "#/$defs/permille" },
        "firePermille": { "$ref": "#/$defs/permille" },
        "biddabilityPermille": { "$ref": "#/$defs/permille" },
        "heartPermille": { "$ref": "#/$defs/permille" }
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["rulesVersion", "seed", "surface", "roundIndex", "horse"],
      "properties": {
        "rulesVersion": { "const": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "surface": { "enum": ["HardPack", "LooseSand", "TackyClay", "MuddySlop", "Mixed"] },
        "roundIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
        "horse": { "$ref": "#/$defs/horse" }
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["tick", "leftPermille", "rightPermille", "cadenceTap", "gateTap", "wrap", "drive"],
      "properties": {
        "tick": { "type": "integer", "minimum": 1, "maximum": 7500 },
        "leftPermille": { "$ref": "#/$defs/permille" },
        "rightPermille": { "$ref": "#/$defs/permille" },
        "cadenceTap": { "type": "boolean" },
        "gateTap": { "type": "boolean" },
        "wrap": { "type": "boolean" },
        "drive": { "enum": ["None", "Left", "Right"] }
      }
    }
  }
}
